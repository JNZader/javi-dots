{
  "name": "javi-dots",
  "version": "1.2.3",
  "description": "Developer workstation setup — AI CLIs, SDD, memory, and code review in one command",
  "type": "module",
  "bin": {
    "javi-dots": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.tsx",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "package:check": "npm pack --dry-run --json --cache /tmp/javi-dots-npm-pack-cache > /tmp/javi-dots-pack.json && node scripts/verify-package-contents.mjs /tmp/javi-dots-pack.json"
  },
  "keywords": [
    "developer-tools",
    "ai",
    "workstation",
    "setup",
    "claude",
    "opencode",
    "sdd"
  ],
  "author": "JNZader",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JNZader/javi-dots.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "meow": "^14.1.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/__integration__/**",
    "!dist/e2e/**",
    "README.md",
    "LICENSE*"
  ]
}
